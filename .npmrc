# pnpm peer dependency resolution settings
# NestJS has many peer deps — allow them to resolve smoothly
auto-install-peers=true
strict-peer-dependencies=false

# Note: better-sqlite3 uses prebuild-install to download prebuilt native binaries.
# If prebuild-install fails (no prebuilt for your platform), pnpm will fall back
# to node-gyp which requires Python 3 + Xcode CLT (macOS) or build-essential (Linux).
# Node.js 22 arm64 macOS prebuilts are provided by the better-sqlite3 project.
