# .env.example — Copy to .env and fill in real values before running Phase 2 or Phase 3.
# .env is gitignored; only this example file is committed (D-13).

# Anthropic API key — used by the agent in Phase 3 (AgentService / betaZodTool + toolRunner).
# Get yours at: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# OpenAI API key — used for embeddings (text-embedding-3-small) and vision fallback (gpt-4o-mini) in Phase 2.
# Get yours at: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Optional: override the SQLite database file path (default: apps/api/db/database.sqlite).
# DB_PATH=

# Optional: override the API server port (default: 3001).
# PORT=3001

# Optional: override the allowed CORS origin (default: http://localhost:3000).
# CORS_ORIGIN=http://localhost:3000
