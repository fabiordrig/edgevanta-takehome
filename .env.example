# .env.example — Copy to .env and fill in real values before running.
# .env is gitignored; only this example file is committed.

# Anthropic API key — used by the agent (AgentService / betaZodTool + toolRunner).
# Get yours at: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# OpenAI API key — used for embeddings (text-embedding-3-small) and vision fallback (gpt-4o-mini).
# Get yours at: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# API server port (NestJS).
PORT=3001

# Allowed CORS origin for the NestJS API.
CORS_ORIGIN=http://localhost:3000

# Frontend → backend base URL. The Next.js web app reads this to reach the NestJS API.
# NEXT_PUBLIC_ prefix inlines it into the client bundle at build time (safe — this is a URL, not a secret).
# NOTE: Never prefix ANTHROPIC_API_KEY or OPENAI_API_KEY with NEXT_PUBLIC_ — those are server-side secrets.
NEXT_PUBLIC_API_URL=http://localhost:3001

# SQLite database file path — default DB location; matches apps/api/src/database/database.service.ts.
DB_PATH=apps/api/db/database.sqlite
